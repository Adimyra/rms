 "font_size": 14,
 "html": "<div style=\"text-align: center; font-size: 18px; font-weight: bold; text-transform: uppercase;\">\n    Department of Posts India<br>\n    <p style=\"font-size: 16px; font-weight: 400;\">Dhanbad NSH</p>\n    <span style=\"font-size: 15px; font-weight: 400;\">Speed Post Manifest</span>\n</div>\n\n<br>\n<hr style=\"border: 1px solid black; margin: 10px 0;\">\n\n<p style=\"color: black; font-weight: 600;\">\n    Prepared On: <span style=\"font-weight: normal;\">{{ doc.get_formatted('date_and_time_of_receipt') }}</span>\n</p>\n\n<table style=\"width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px;\">\n    <thead>\n        <tr>\n            <th style=\"color: black; font-weight: 600; padding: 5px; text-align: left;\">Flight / Schedule No</th>\n            <th style=\"color: black; font-weight: 600; text-align: center;\">Bag Number</th>\n            <th style=\"color: black; font-weight: 600; padding: 5px; text-align: right;\">Bag Received From</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td style=\"padding: 5px; text-align: left;\">{{ doc.flight_schedule_no or \"\" }}</td>\n            <td style=\"padding: 5px; text-align: center;\">{{ doc.name }}</td>\n            <td style=\"padding: 5px; text-align: right;\">{{ doc.receipt_from }}</td>\n        </tr>\n    </tbody>\n</table>\n\n<div style=\"text-align: left;\">\n    <p style=\"color: black; font-weight: 600;\">Bag Weight: </p>{{ doc.weight_in_kg }} Kgs\n</div>\n<br><br>\n\n<div style=\"text-align: right; margin: 0 30px;\">\n    <p style=\"font-weight: 500;\">Stamp</p>\n</div>\n\n<hr style=\"border: 1px solid black; margin: 10px 0;\">\n<br>\n<div style=\"text-align: center; font-size: 16px; font-weight: bold;\">\n    Details of Speed Post Articles\n</div>\n<br>\n\n<table style=\"width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px;\">\n    <thead>\n        <tr>\n            <th style=\"color: black; font-weight: 600; border: 1px solid black; padding: 5px; text-align: center;\">Sl No</th>\n            <th style=\"color: black; font-weight: 600; border: 1px solid black; padding: 5px; text-align: center;\">Article No</th>\n            <th style=\"color: black; font-weight: 600; border: 1px solid black; padding: 5px; text-align: center;\">Sl No</th>\n            <th style=\"color: black; font-weight: 600; border: 1px solid black; padding: 5px; text-align: center;\">Article No</th>\n            <th style=\"color: black; font-weight: 600; border: 1px solid black; padding: 5px; text-align: center;\">Sl No</th>\n            <th style=\"color: black; font-weight: 600; border: 1px solid black; padding: 5px; text-align: center;\">Article No</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for i, row in enumerate(doc.barcodes) %}\n            {% if loop.index0 % 3 == 0 %}\n                <tr>\n            {% endif %}\n                <td style=\"border: 1px solid black; padding: 5px; text-align: center;\">{{ loop.index }}</td>\n                <td style=\"border: 1px solid black; padding: 5px; text-align: center;\">{{ row.bag_number }}</td>\n            {% if loop.index0 % 3 == 2 or loop.last %}\n                </tr>\n            {% endif %}\n        {% endfor %}\n    </tbody>\n</table>\n\n<div style=\"width: 50%; margin-left: auto; text-align: right;\">\n    <table style=\"width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px;\">\n        <tr>\n            <th style=\"text-align: left; color: black; font-weight: 600;\">Ordinary & VP</th>\n            <td style=\"text-align: center;\">:</td>\n            <td style=\"text-align: right;\">{{ doc.total_scanned_article - (doc.ins_ins_vp or 0) }}</td>\n        </tr>\n        <tr>\n            <th style=\"text-align: left; color: black; font-weight: 600;\">INS & INS VP</th>\n            <td style=\"text-align: center;\">:</td>\n            <td style=\"text-align: right;\">{{ doc.ins_ins_vp or 0 }}</td>\n        </tr>\n        <tr style=\"margin-top: 10px;\">\n            <th style=\"text-align: left; color: black; font-weight: 800; font-size: 18px; padding-top: 10px;\">Total</th>\n            <td style=\"text-align: center;\">:</td>\n            <td style=\"text-align: right; font-size: 18px; font-weight: 800;\">{{ doc.total_scanned_article }}</td>\n        </tr>\n    </table>\n</div>\n<br>\n<table style=\"width: 100%; border-collapse: collapse; border-spacing: 0; margin-top: 10px; font-size: 14px;\">\n    <thead>\n        <tr>\n            <th style=\"color: black; font-weight: 800; padding: 5px; text-align: center;\">{{ doc.name_of_official }}</th>\n            <th style=\"color: black; font-weight: 600; text-align: center;\"></th>\n            <th style=\"color: black; font-weight: 600; padding: 5px; text-align: center;\"></th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td style=\"padding: 5px; font-weight: 500; text-align: center;\">Officer Opening Bag<br>(Signature)</td>\n            <td style=\"padding: 5px; font-weight: 500; text-align: center;\">Officer Delivering Bag</td>\n            <td style=\"padding: 5px; font-weight: 500; text-align: center;\">Date Stamp of<br>Delivering Office</td>\n        </tr>\n    </tbody>\n</table>\n\n<br>\n<div style=\"text-align: left;\">\n    <p style=\"color: black; font-weight: 600;\">Set Number: {{ doc.set_no }}</p>\n</div>\n<strong>{{ doc.get_formatted('date_and_time_of_receipt').split(' ')[0] }}</strong>\n",
